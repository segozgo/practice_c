#include <stdio.h>
#include <stdlib.h>
#define MAP_LEN 30

struct enemy_stat {
    int hp;
    int speed;
    int type;
    int loc;
};

struct enemy {
    int common;
    int uncommon;
    int amror;
    struct enemy_stat ENEMY;
};

struct tower_stat {
    int type;
    int range;
    int damage;
    int tower_loc;
};

struct tower {
    int MG;
    int AC;
    int RAILG;
    struct tower_stat TOWER;
};

void spawn_enemy(int turn, int *enemy_counter, struct enemy **E1) {

    int slot_index = -1;

    for(int i = 0; i < (*enemy_counter); i++) {
        if((*E1)[i].ENEMY.type == 0) {
            slot_index = i;
            break;
        }
    }
    if(slot_index != -1) {
        if(turn > 0 && turn < 5) {
            (*E1)[slot_index].ENEMY.loc = 0;
            (*E1)[slot_index].ENEMY.type = 1;
        }
        else if(turn > 4 && turn < 7) {
        (*E1)[slot_index].ENEMY.loc = 0;
        (*E1)[slot_index].ENEMY.type = 2;
        }
        else if(turn == 8) {
            (*E1)[slot_index].ENEMY.loc = 0;
            (*E1)[slot_index].ENEMY.type = 3;
        }
        return;
    }

    if(slot_index == -1) {
        (*enemy_counter)++;

        struct enemy *temp = realloc(*E1, sizeof(struct enemy) * *enemy_counter);
            if(temp == NULL) {
                printf("allocation failed");
                free(temp);
                exit(1);
            }
        *E1 = temp;
        slot_index = *(enemy_counter) - 1;

        if(turn > 0 && turn < 5) {
            (*E1)[slot_index].ENEMY.loc = 0;
            (*E1)[slot_index].ENEMY.type = 1;
        }
        else if(turn > 4 && turn < 7) {
            (*E1)[slot_index].ENEMY.loc = 0;
            (*E1)[slot_index].ENEMY.type = 2;
        }
        else if(turn == 8) {
            (*E1)[slot_index].ENEMY.loc = 0;
            (*E1)[slot_index].ENEMY.type = 3;
        }
    }
}

void enemy_move(int *enemy_counter, struct enemy **E1) {
    for(int i = 0; i < *enemy_counter; i++) {
        if((*E1)[i].ENEMY.type == 0) {
            continue;
        }
        if((*E1)[i].ENEMY.type == 1) {
            (*E1)[i].ENEMY.speed = 2; 
        }
        else if((*E1)[i].ENEMY.type == 2) {
            (*E1)[i].ENEMY.speed = 3;
        }
        else if((*E1)[i].ENEMY.type == 3) {
            (*E1)[i].ENEMY.speed = 1;
        }

        for(int j = 0; j < (*E1)[i].ENEMY.speed; j++) {
            int next_loc = (*E1)[i].ENEMY.loc + 1;
            int is_bloc = 0;

            for(int k = 0; k < *enemy_counter; k++) {
                if(i != k && next_loc == (*E1)[k].ENEMY.loc && (*E1)[k].ENEMY.type != 0) {
                    is_bloc = 1;
                    break;;
                }
            }
            if(is_bloc == 0) {
                (*E1)[i].ENEMY.loc = next_loc;
            }
            else if(is_bloc == 1) {
                break;
            }
        }
        if((*E1)[i].ENEMY.loc > MAP_LEN) {
            (*E1)[i].ENEMY.type = 0;
            (*E1)[i].ENEMY.loc = 0;
        }       
    }  
}

void map_render(int enemy_counter, struct enemy *E1) {
    for(int i = 0; i < MAP_LEN; i++) {
        int j;
        for(j = 0; j < enemy_counter; j++) {
            if(E1[j].ENEMY.type != 0 && E1[j].ENEMY.loc == i) {
                printf("%d ", E1[j].ENEMY.type);
                break;
            }
        }
        if(j == enemy_counter) {
        printf("0 ");
        }
    }
    printf("\n");
}


int main() {
    int enemy_counter = 1;
    int turn = 0;
    int map_len[MAP_LEN];
    struct enemy *E1 = (struct enemy*)malloc(sizeof(struct enemy) * enemy_counter);
    if(E1 == NULL) {
        return 1;
    }
    E1[0].ENEMY.type = 0;
    E1[0].ENEMY.loc = 0;


    while(1) { 
        spawn_enemy(turn, &enemy_counter, &E1);
        map_render(enemy_counter, E1);
        enemy_move(&enemy_counter, &E1);
        turn++;
        if(turn > 50) break;
    }
    free(E1);

    return 0;
}
