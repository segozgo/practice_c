#include <stdio.h>
#include <stdlib.h>

int map_len[30] = {0};

struct tower_stat {
    int range;
    int damage;
    int tower_loc;
};

struct tower {
    int MG;
    int AC;
    struct tower_stat tow_stat;
};

struct enemy {
    int hp;
    int speed;
    int type; 
    int loc;
};

void spawn_ene(int turn, int *maxi_ene, int *enemy_counter, struct enemy **actene) {
    if(turn > 0 && turn < 5) {
        if(*maxi_ene <= *enemy_counter) {
            *maxi_ene += 2;
            struct enemy *tem = realloc(*actene, sizeof(struct enemy) * *maxi_ene);
            if(tem == NULL) {
                free(tem);
                printf("failed_allocate_memory");
                exit(1);
            }
            *actene = tem;
        }
        (*actene)[*enemy_counter].hp = 3;
        (*actene)[*enemy_counter].speed = 1;
        (*actene)[*enemy_counter].type = 1;
        (*actene)[*enemy_counter].loc = 0;
        (*enemy_counter)++;
    }
}

void move_ene(int enemy_counter, int map_len[], struct enemy **actene) {
    for(int i = 0; i < enemy_counter; i++) {
        if((*actene)[i].type != 0) {
            map_len[(*actene)[i].loc] = (*actene)[i].type;
            (*actene)[i].loc += (*actene)[i].speed;
        }
    }
}

void map_render (int map_len[], int enemy_counter, struct enemy **actene) {
    for(int i = 0; i < enemy_counter; i++)      
        if((*actene)[i].hp == 0) {
            (*actene)[i].type = 0;
            (*actene)[i].loc = 0;
        }
        for(int i = 0; i < 30; i++) {
            printf("%d " , map_len[i]);
        }
        printf("\n");
}

void tow_attack (int map_len[], int enemy_counter, struct enemy **actene, struct tower *t1) {
    map_len[t1 -> tow_stat.tower_loc] = t1 -> MG;
    for(int i = 0; i < enemy_counter; i++) {
        if((*actene)[i].loc <= (t1 -> tow_stat.tower_loc) && t1 -> tow_stat.range >= (t1 -> tow_stat.tower_loc - (*actene)[i].loc)) {
            (*actene)[i].hp -= t1 -> tow_stat.damage;
        }
    }
}

int main() {
    int turn = 0;
    int maxi_ene = 1;
    int enemy_counter = 0;
    struct tower t1;
    t1.MG = 11;
    t1.tow_stat.range = 5;
    t1.tow_stat.damage = 1;
    t1.tow_stat.tower_loc = 10;
    struct enemy *actene = (struct enemy*)malloc(sizeof(struct enemy));

    if(actene == NULL) {
        free(actene);
        printf("failed_allocate_memory");
        exit(1);
    }

    while(map_len[29] == 0) {
        if(turn == 0) {
            printf("...");
        }

        spawn_ene(turn, &maxi_ene, &enemy_counter, &actene);

        for(int i = 0; i < 30; i++) {
            map_len[i] = 0;
        }

        tow_attack(map_len, enemy_counter, &actene, &t1);
        move_ene(enemy_counter, map_len, &actene);
        map_render(map_len, enemy_counter, &actene);

        turn++;
        if(turn > 50) {
            exit(1);
        }
    }

    
    free(actene);
    actene = NULL;

    return 0;
}
