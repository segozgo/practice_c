#include <stdio.h>
#include <stdlib.h>

int map_len[30] = {0};

struct tower {
    int MG;
    int AC;
};

struct enemy {
    int hp;
    int speed;
    int type; 
    int loc;
};

int main() {
    int turn = 0;

    struct enemy *actene[10] = {0};
    int counter = 0;

    while(map_len[29] == 0) {
        if(turn == 0) {
            printf("...");
        }

        if(turn > 0 && turn < 4) {
            struct enemy *e = (struct enemy*)malloc(sizeof(struct enemy));
            e -> hp = 3;
            e -> speed = 1;
            e -> type = 1;
            e -> loc = 0;
            actene[counter] = e;
            counter++;
        }
        
        printf("\nmemory_allocated\n");

        for(int i = 0; i < 30; i++) {
            map_len[i] = 0;
        }

        for(int i = 0; i < counter; i++) {
            if(actene[i] != NULL) {
                actene[i] -> loc += actene[i] -> speed;
                map_len[actene[i] -> loc] = actene[i] -> type;
            }
        }

        for(int i = 0; i < 30; i++) {
            printf("%d " , map_len[i]);
        }

        turn++;
        if(turn > 50) {
            exit(1);
        }
    }

    for(int i = 0; i < counter; i++) {
        free(actene[i]);
        actene[i] = NULL;
        }

    return 0;
}
