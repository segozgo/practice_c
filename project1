#include <stdio.h>

int map_len[30] = {0};

struct enemy {
    int common;
    int rare;
};

struct speed {
    int common_speed;
    int rare_speed;
};

int *enemy_var[5] = {NULL};

int main() {
    struct enemy b1;
    b1.common = 1;
    b1.rare = 2;
    int turn = 0;

    struct speed bs;
    bs.common_speed = 1;
    bs.rare_speed = 2;

    while(map_len[29] == 0) {
        if(turn == 0) {
            enemy_var[0] = map_len;
            *enemy_var[0] = b1.rare;
            map_len[0] = *enemy_var[0];
        }

        if(turn > 0 && turn < 3) {
            enemy_var[turn] = map_len;
            *enemy_var[turn] = b1.common;
            map_len[0] = *enemy_var[turn];
            }

        for(int i = 0; i < 30; i++) {
            printf("%d ", map_len[i]);
        }

        for(int i = 0; i < 3; i++) {
            if(enemy_var[i] != NULL) {
                *enemy_var[i] = 0;
                if(i == 0) {
                    enemy_var[i] += bs.rare_speed;
                    *enemy_var[i] = b1.rare;
                }
                if(i > 0) {
                    enemy_var[i] += bs.common_speed;
                    *enemy_var[i] = b1.common;
                }
            }
        }

        printf("current turn : %d\n", turn);
        turn++;
    }

    return 0;
}
