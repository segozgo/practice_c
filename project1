#include <stdio.h>

int map_len[30] = {0};

struct enemy {
    int common;
    int rare;
};

struct speed {
    int common_speed;
    int rare_speed;
};

int main() {
    int *enemy_loc[4] = {NULL};
    int turn = 0;

    struct enemy bv;
    bv.common = 1;
    bv.rare = 2;

    struct speed bs;
    bs.common_speed = 1;
    bs.rare_speed = 2;

    while(map_len[29] == 0) {
        if(turn == 0) {
            map_len[0] = bv.rare;
            enemy_loc[turn] = &map_len[0];
        }

        if(turn > 0 && turn < 4) {
            map_len[0] = bv.common;
            enemy_loc[turn] = &map_len[0];
        }

        for(int i = 0; i < 30; i++) {
            printf("%d ", map_len[i]);
        }

        for(int i = 0; i < 4; i++) {
            if(enemy_loc[i] != NULL) {
                if(*enemy_loc[i] == 1) {
                    *enemy_loc[i] = 0;
                    enemy_loc[i] += bs.common_speed;
                    *enemy_loc[i] = bv.common;
                }

                else if(*enemy_loc[i] == 2) {
                    *enemy_loc[i] = 0;
                    enemy_loc[i] += bs.rare_speed;
                    *enemy_loc[i] = bv.rare;
                }

                if(enemy_loc[i] < map_len + 30) {
                    *enemy_loc[0] = bv.rare;
                }

                else {
                    enemy_loc[0] = NULL;
                    break;
                }
            }
            
        } 

        printf("current turn : %d\n", turn);

        turn++;
    }
    return 0;
}
    return 0;
}
